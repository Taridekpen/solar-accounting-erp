# Production secrets — copy to .env.production and fill in real values.
NODE_ENV=production
PORT=3000

# Prefer a managed Postgres URL in real deployments. Compose can still host Postgres
# without publishing its port (see docker-compose.prod.yml).
POSTGRES_USER=solar
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=solar_accounting
DATABASE_URL=postgresql://solar:replace-with-strong-password@postgres:5432/solar_accounting?schema=public

REDIS_URL=redis://redis:6379
WEB_ORIGIN=https://accounting.example.com
SESSION_SECRET=replace-with-at-least-32-characters-secret
COOKIE_SECURE=true
LOG_LEVEL=info

# Optional: when set, application logs may note the DSN for log shipping.
# No SaaS SDK is required; prefer Pino JSON stdout and /health.
SENTRY_DSN=

# TLS certs for nginx (lab: generate self-signed into infrastructure/certs)
TLS_CERT_DIR=./infrastructure/certs
WEB_HTTPS_PORT=443
WEB_HTTP_PORT=80
