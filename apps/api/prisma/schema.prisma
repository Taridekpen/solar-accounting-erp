}

model SalarySummary {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  branchId           String              @map("branch_id") @db.Uuid
  departmentId       String?             @map("department_id") @db.Uuid
  summaryNumber      String              @map("summary_number")
  periodStart        DateTime            @map("period_start") @db.Date
  periodEnd          DateTime            @map("period_end") @db.Date
  grossAmount        Decimal             @map("gross_amount") @db.Decimal(19, 4)
  netAmount          Decimal             @map("net_amount") @db.Decimal(19, 4)
  approvalReference  String              @map("approval_reference")
  summaryFileName    String              @map("summary_file_name")
  summaryFileData    Bytes               @map("summary_file_data")
  status             SalarySummaryStatus @default(draft)
  journalEntryId     String?             @unique @map("journal_entry_id") @db.Uuid
  createdByUserId    String              @map("created_by_user_id") @db.Uuid
  approvedByUserId   String?             @map("approved_by_user_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company                  @relation(fields: [companyId], references: [id])
  branch     Branch                   @relation(fields: [branchId], references: [id])
  department Department?              @relation(fields: [departmentId], references: [id])
  createdBy  User                     @relation("SalarySummaryCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy User?                    @relation("SalarySummaryApprovedBy", fields: [approvedByUserId], references: [id])
  deductions SalarySummaryDeduction[]
  allocations SalaryPaymentAllocation[]

  @@unique([companyId, summaryNumber])
  @@index([companyId, branchId, status])
  @@map("salary_summaries")
}

model SalarySummaryDeduction {
  id          String  @id @default(uuid()) @db.Uuid
  summaryId   String  @map("summary_id") @db.Uuid
  accountId   String  @map("account_id") @db.Uuid
  description String
  amount      Decimal @db.Decimal(19, 4)

  summary SalarySummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  account Account       @relation(fields: [accountId], references: [id])

  @@index([summaryId])
  @@map("salary_summary_deductions")
}

model SalaryPayment {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  paymentNumber    String   @map("payment_number")
  paymentDate      DateTime @map("payment_date") @db.Date
  total            Decimal  @db.Decimal(19, 4)
  paymentAccountId String   @map("payment_account_id") @db.Uuid
  bankReference    String   @map("bank_reference")
  journalEntryId   String?  @unique @map("journal_entry_id") @db.Uuid
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company        Company                   @relation(fields: [companyId], references: [id])
  branch         Branch                    @relation(fields: [branchId], references: [id])
  paymentAccount Account                   @relation("SalaryPaymentAccount", fields: [paymentAccountId], references: [id])
  createdBy      User                      @relation("SalaryPaymentCreatedBy", fields: [createdByUserId], references: [id])
  allocations    SalaryPaymentAllocation[]

  @@unique([companyId, paymentNumber])
  @@index([companyId, branchId, paymentDate])
  @@map("salary_payments")
}

model SalaryPaymentAllocation {
  id         String  @id @default(uuid()) @db.Uuid
  paymentId  String  @map("payment_id") @db.Uuid
  summaryId  String  @map("summary_id") @db.Uuid
  amount     Decimal @db.Decimal(19, 4)

  payment SalaryPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  summary SalarySummary @relation(fields: [summaryId], references: [id])

  @@index([paymentId])
  @@index([summaryId])
  @@map("salary_payment_allocations")
}

model DocumentTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @unique @map("company_id") @db.Uuid
  invoiceFooter    String   @default("") @map("invoice_footer")
  quotationTerms   String   @default("") @map("quotation_terms")
  paymentAdvice    String   @default("") @map("payment_advice")
  updatedByUserId  String?  @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company @relation(fields: [companyId], references: [id])
  updatedBy User?   @relation("DocumentTemplateUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("document_templates")
}

model ManagedDocument {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  documentKind String   @map("document_kind")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  content      Bytes
  byteSize     Int      @map("byte_size")
  uploadedByUserId String @map("uploaded_by_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company    Company @relation(fields: [companyId], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id])
  uploadedBy User    @relation("ManagedDocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([branchId])
  @@map("managed_documents")
}

model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  type            String
  title           String
  body            String
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id")
  linkPath        String?   @map("link_path")
  branchScope     Json?     @map("branch_scope")
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  emailQueuedAt   DateTime? @map("email_queued_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company @relation(fields: [companyId], references: [id])
  recipient User    @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, type, entityId])
  @@map("notifications")
}

model ImportBatch {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @map("company_id") @db.Uuid
  importType             String   @map("import_type")
  fileName               String   @map("file_name")
  mimeType               String   @map("mime_type")
  content                Bytes
  status                 String   @default("uploaded")
  rowCount               Int      @default(0) @map("row_count")
  okCount                Int      @default(0) @map("ok_count")
  errorCount             Int      @default(0) @map("error_count")
  duplicateCount         Int      @default(0) @map("duplicate_count")
  errorSummary           Json?    @map("error_summary")
  reconciliationSummary  Json?    @map("reconciliation_summary")
  importReport           Json?    @map("import_report")
  createdByUserId        String   @map("created_by_user_id") @db.Uuid
  approvedByUserId       String?  @map("approved_by_user_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company     @relation(fields: [companyId], references: [id])
  createdBy User        @relation("ImportBatchCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy User?      @relation("ImportBatchApprovedBy", fields: [approvedByUserId], references: [id])
  rows      ImportRow[]

  @@index([companyId, status])
  @@map("import_batches")
}

model ImportRow {
  id             String   @id @default(uuid()) @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  rowNumber      Int      @map("row_number")
  raw            Json
  normalized     Json?
  status         String   @default("ok")
  messages       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("import_rows")
}
