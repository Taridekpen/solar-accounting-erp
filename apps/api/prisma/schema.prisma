generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  active
  inactive

  @@map("record_status")
}

enum EmploymentStatus {
  active
  inactive
  terminated

  @@map("employment_status")
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense

  @@map("account_type")
}

enum NormalBalance {
  debit
  credit

  @@map("normal_balance")
}

enum UserStatus {
  invited
  active
  suspended
  locked

  @@map("user_status")
}

enum AuthTokenPurpose {
  invitation
  password_reset

  @@map("auth_token_purpose")
}

enum FiscalPeriodStatus {
  open
  closing
  closed
  reopened

  @@map("fiscal_period_status")
}

enum DailyClosingStatus {
  draft
  reviewed

  @@map("daily_closing_status")
}

enum PeriodCloseAction {
  lock
  reopen

  @@map("period_close_action")
}

enum JournalStatus {
  draft
  pending_approval
  posted
  rejected

  @@map("journal_status")
}

enum OpeningDetailKind {
  cash
  bank
  inventory
  customer_invoice
  supplier_bill
  fixed_asset
  depreciation
  loan
  equity

  @@map("opening_detail_kind")
}

enum PostingAttemptStatus {
  failed
  suspicious

  @@map("posting_attempt_status")
}

model SystemMetadata {
  id              String   @id @default(uuid()) @db.Uuid
  applicationName String   @unique @map("application_name")
  schemaVersion   String   @map("schema_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_metadata")
}

model Company {
  id                      String       @id @default(uuid()) @db.Uuid
  singletonKey            String       @unique @default("default") @map("singleton_key")
  legalName               String       @map("legal_name")
  tradingName             String?      @map("trading_name")
  registrationNumber      String?      @map("registration_number")
  taxIdentificationNumber String?      @map("tax_identification_number")
  email                   String?
  phone                   String?
  website                 String?
  address                 String?
  city                    String?
  state                   String?
  country                 String       @default("Nigeria")
  baseCurrency            String       @default("NGN") @map("base_currency") @db.VarChar(3)
  timezone                String       @default("Africa/Lagos")
  fiscalYearStartMonth    Int          @default(1) @map("fiscal_year_start_month")
  purchaseApprovalLimit       Decimal      @default(500000) @map("purchase_approval_limit") @db.Decimal(19, 4)
  logoUrl                     String?      @map("logo_url")
  inventoryCostingMethod      String       @default("weighted_average") @map("inventory_costing_method")
  moneyRoundingMode           String       @default("half_up") @map("money_rounding_mode")
  emailNotificationsEnabled   Boolean      @default(false) @map("email_notifications_enabled")
  status                      RecordStatus @default(active)
  createdAt                   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                   DateTime?    @map("deleted_at") @db.Timestamptz(6)

  branches          Branch[]
  departments       Department[]
  employees         Employee[]
  documentSequences DocumentSequence[]
  accounts          Account[]
  users             User[]
  fiscalYears       FiscalYear[]
  fiscalPeriods     FiscalPeriod[]
  dailyClosings     DailyClosing[]
  periodClosingTasks PeriodClosingTask[]
  periodCloseApprovals PeriodCloseApproval[]
  periodStatementSnapshots PeriodStatementSnapshot[]
  journals          JournalEntry[]
  accountMappings   AccountMapping[]
  postingAttempts   PostingAttempt[]
  openingBatches    OpeningBalanceBatch[]
  customers         Customer[]
  productCategories ProductCategory[]
  products          Product[]
  stockMovements    StockMovement[]
  stockPositions    StockPosition[]
  quotations        SalesQuotation[]
  invoices          SalesInvoice[]
  receipts          CustomerReceipt[]
  creditNotes       SalesCreditNote[]
  returnRequests    SalesReturnRequest[]
  suppliers         Supplier[]
  warehouses        Warehouse[]
  requisitions      PurchaseRequisition[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierBills     SupplierBill[]
  supplierPayments  SupplierPayment[]
  procurementApprovals ProcurementApproval[]
  receiptSerials    GoodsReceiptSerial[]
  warehouseStocks   WarehouseStock[]
  stockTransfers    StockTransfer[]
  stockCounts       StockCount[]
  expenseCategories ExpenseCategory[]
  expensePolicies   ExpenseApprovalPolicy[]
  expenseBudgets    ExpenseBudget[]
  expenses          Expense[]
  expenseApprovals  ExpenseApproval[]
  bankAccounts      BankAccount[]
  cashDrawers       CashDrawer[]
  cashTransfers     CashTransfer[]
  cashCounts        CashCount[]
  bankStatements    BankStatement[]
  projects          Project[]
  taxCodes          TaxCode[]
  statementBudgets  StatementBudget[]
  fixedAssets       FixedAsset[]
  salarySummaries   SalarySummary[]
  salaryPayments    SalaryPayment[]
  documentTemplates DocumentTemplate?
  managedDocuments  ManagedDocument[]
  notifications     Notification[]
  importBatches     ImportBatch[]

  @@map("companies")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  branchCode   String       @map("branch_code")
  name         String
  address      String?
  city         String?
  state        String?
  phone        String?
  email        String?
  managerId    String?      @map("manager_id") @db.Uuid
  isHeadOffice Boolean      @default(false) @map("is_head_office")
  status       RecordStatus @default(active)
  openingDate  DateTime?    @map("opening_date") @db.Date
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  company           Company            @relation(fields: [companyId], references: [id])
  manager           Employee?          @relation("BranchManager", fields: [managerId], references: [id])
  employees         Employee[]         @relation("EmployeeBranch")
  departments       Department[]
  documentSequences DocumentSequence[]
  userAssignments   UserBranchAssignment[]
  journalLines      JournalLine[]
  customerLinks     CustomerBranch[]
  stockMovements    StockMovement[]
  stockPositions    StockPosition[]
  quotations        SalesQuotation[]
  invoices          SalesInvoice[]
  receipts          CustomerReceipt[]
  creditNotes       SalesCreditNote[]
  returnRequests    SalesReturnRequest[]
  supplierLinks     SupplierBranch[]
  warehouses        Warehouse[]
  requisitions      PurchaseRequisition[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  supplierBills     SupplierBill[]
  supplierPayments  SupplierPayment[]
  transfersOut      StockTransfer[] @relation("TransferSourceBranch")
  transfersIn       StockTransfer[] @relation("TransferDestinationBranch")
  stockCounts       StockCount[]
  expensePolicies   ExpenseApprovalPolicy[]
  expenseBudgets    ExpenseBudget[]
  expenses          Expense[]
  bankAccounts      BankAccount[]
  cashDrawers       CashDrawer[]
  cashTransfersOut  CashTransfer[] @relation("CashTransferSourceBranch")
  cashTransfersIn   CashTransfer[] @relation("CashTransferDestinationBranch")
  cashCounts        CashCount[]
  projects          Project[]
  statementBudgets  StatementBudget[]
  fixedAssets       FixedAsset[]
  dailyClosings     DailyClosing[]
  salarySummaries   SalarySummary[]
  salaryPayments    SalaryPayment[]
  managedDocuments  ManagedDocument[]

  @@unique([companyId, branchCode])
  @@index([companyId, status])
  @@map("branches")
}

model Department {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  branchId  String?      @map("branch_id") @db.Uuid
  name      String
  code      String
  status    RecordStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  employees    Employee[]
  journalLines JournalLine[]
  expensePolicies ExpenseApprovalPolicy[]
  expenses     Expense[]
  salarySummaries SalarySummary[]

  @@index([companyId, branchId])
  @@map("departments")
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  employeeNumber   String           @map("employee_number")
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  email            String?
  phone            String?
  branchId         String           @map("branch_id") @db.Uuid
  departmentId     String?          @map("department_id") @db.Uuid
  jobTitle         String?          @map("job_title")
  employmentStatus EmploymentStatus @default(active) @map("employment_status")
  hireDate         DateTime?        @map("hire_date") @db.Date
  userId           String?          @unique @map("user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  company          Company     @relation(fields: [companyId], references: [id])
  branch           Branch      @relation("EmployeeBranch", fields: [branchId], references: [id])
  department       Department? @relation(fields: [departmentId], references: [id])
  managedBranches  Branch[]    @relation("BranchManager")
  account          User?       @relation("EmployeeAccount", fields: [userId], references: [id])
  userProfile      User?       @relation("UserEmployee")
  expenses         Expense[]
  managedProjects  Project[] @relation("ProjectManager")

  @@unique([companyId, employeeNumber])
  @@index([companyId, branchId])
  @@index([branchId, hireDate])
  @@map("employees")
}

model DocumentSequence {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  documentType String   @map("document_type")
  prefix       String
  nextNumber   Int      @default(1) @map("next_number")
  padding      Int      @default(4)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([companyId, branchId, documentType])
  @@index([branchId, documentType])
  @@map("document_sequences")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Account {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  accountCode      String        @map("account_code")
  accountName      String        @map("account_name")
  accountType      AccountType   @map("account_type")
  accountSubtype   String?       @map("account_subtype")
  parentAccountId  String?       @map("parent_account_id") @db.Uuid
  normalBalance    NormalBalance @map("normal_balance")
  isPostable       Boolean       @default(true) @map("is_postable")
  isControlAccount Boolean       @default(false) @map("is_control_account")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)

  company         Company          @relation(fields: [companyId], references: [id])
  parent          Account?         @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children        Account[]        @relation("AccountHierarchy")
  journalLines    JournalLine[]
  debitMappings   AccountMapping[] @relation("DebitMapping")
  creditMappings  AccountMapping[] @relation("CreditMapping")
  taxMappings     AccountMapping[] @relation("TaxMapping")
  revenueProducts Product[]        @relation("ProductRevenue")
  expenseCategories ExpenseCategory[]
  expensePayments Expense[]        @relation("ExpensePaymentAccount")
  taxCodes        TaxCode[]
  bankLedgers     BankAccount[]
  cashDrawers     CashDrawer[]
  transferSources CashTransfer[]   @relation("TransferSourceAccount")
  transferDestinations CashTransfer[] @relation("TransferDestinationAccount")
  salaryDeductions SalarySummaryDeduction[]
  salaryPayments  SalaryPayment[] @relation("SalaryPaymentAccount")

  @@unique([companyId, accountCode])
  @@index([companyId, accountType])
  @@map("accounts")
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  companyId            String     @map("company_id") @db.Uuid
  employeeId           String?    @unique @map("employee_id") @db.Uuid
  email                String     @unique
  passwordHash         String?    @map("password_hash")
  status               UserStatus @default(invited)
  failedLoginCount     Int        @default(0) @map("failed_login_count")
  lockedUntil          DateTime?  @map("locked_until") @db.Timestamptz(6)
  mfaEnabled           Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEncrypted   String?    @map("mfa_secret_encrypted")
  passwordChangedAt    DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company              Company                @relation(fields: [companyId], references: [id])
  employee             Employee?              @relation("UserEmployee", fields: [employeeId], references: [id])
  employeeAccount      Employee?              @relation("EmployeeAccount")
  sessions             Session[]
  roles                UserRole[]
  branchAssignments    UserBranchAssignment[]
  authTokens           AuthToken[]
  delegationsGiven     ApprovalDelegation[]   @relation("Delegator")
  delegationsReceived  ApprovalDelegation[]   @relation("Delegate")
  auditEvents          AuditEvent[]
  journalsCreated      JournalEntry[]         @relation("JournalCreatedBy")
  journalsApproved     JournalEntry[]         @relation("JournalApprovedBy")
  journalsPosted       JournalEntry[]         @relation("JournalPostedBy")
  periodsClosed        FiscalPeriod[]         @relation("PeriodClosedBy")
  periodsClosingStarted FiscalPeriod[]        @relation("PeriodClosingStartedBy")
  dailyClosingsPrepared DailyClosing[]        @relation("DailyClosingPreparedBy")
  dailyClosingsReviewed DailyClosing[]        @relation("DailyClosingReviewedBy")
  periodTasksCompleted PeriodClosingTask[]    @relation("PeriodTaskCompletedBy")
  periodCloseApprovals PeriodCloseApproval[]
  salarySummariesCreated SalarySummary[]      @relation("SalarySummaryCreatedBy")
  salarySummariesApproved SalarySummary[]     @relation("SalarySummaryApprovedBy")
  salaryPaymentsCreated SalaryPayment[]       @relation("SalaryPaymentCreatedBy")
  documentTemplatesUpdated DocumentTemplate[] @relation("DocumentTemplateUpdatedBy")
  managedDocumentsUploaded ManagedDocument[]  @relation("ManagedDocumentUploadedBy")
  notifications            Notification[]
  importBatchesCreated     ImportBatch[]      @relation("ImportBatchCreatedBy")
  importBatchesApproved    ImportBatch[]      @relation("ImportBatchApprovedBy")

  @@index([companyId, status])
  @@map("users")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  csrfTokenHash String    @map("csrf_token_hash")
  mfaPending    Boolean   @default(false) @map("mfa_pending")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tokenHash String           @unique @map("token_hash")
  purpose   AuthTokenPurpose
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserBranchAssignment {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_assignments")
}

model ApprovalDelegation {
  id               String    @id @default(uuid()) @db.Uuid
  delegatorUserId  String    @map("delegator_user_id") @db.Uuid
  delegateUserId   String    @map("delegate_user_id") @db.Uuid
  permissionCode   String    @map("permission_code")
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime  @map("ends_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  delegator User @relation("Delegator", fields: [delegatorUserId], references: [id], onDelete: Cascade)
  delegate  User @relation("Delegate", fields: [delegateUserId], references: [id], onDelete: Cascade)

  @@index([delegateUserId, permissionCode])
  @@map("approval_delegations")
}

model SeparationRule {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("separation_rules")
}

model AuditEvent {
  id              String   @id @default(uuid()) @db.Uuid
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  action          String
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  branchScope     Json?    @map("branch_scope")
  previousValues  Json?    @map("previous_values")
  newValues       Json?    @map("new_values")
  reason          String?
  correlationId   String?  @map("correlation_id")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("audit_events")
}

model FiscalYear {
  id        String             @id @default(uuid()) @db.Uuid
  companyId String             @map("company_id") @db.Uuid
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company        @relation(fields: [companyId], references: [id])
  periods FiscalPeriod[]

  @@unique([companyId, startDate])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  fiscalYearId   String             @map("fiscal_year_id") @db.Uuid
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  status                 FiscalPeriodStatus @default(open)
  closedAt               DateTime?          @map("closed_at") @db.Timestamptz(6)
  closedByUserId         String?            @map("closed_by_user_id") @db.Uuid
  closingStartedByUserId String?            @map("closing_started_by_user_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company                 @relation(fields: [companyId], references: [id])
  year           FiscalYear              @relation(fields: [fiscalYearId], references: [id])
  closedBy       User?                   @relation("PeriodClosedBy", fields: [closedByUserId], references: [id])
  closingStartedBy User?                 @relation("PeriodClosingStartedBy", fields: [closingStartedByUserId], references: [id])
  journals       JournalEntry[]
  closingTasks   PeriodClosingTask[]
  closeApprovals PeriodCloseApproval[]
  snapshot       PeriodStatementSnapshot?

  @@unique([companyId, startDate])
  @@index([companyId, status])
  @@map("fiscal_periods")
}

model DailyClosing {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  branchId          String             @map("branch_id") @db.Uuid
  businessDate      DateTime           @map("business_date") @db.Date
  status            DailyClosingStatus @default(draft)
  preparedByUserId  String             @map("prepared_by_user_id") @db.Uuid
  reviewedByUserId  String?            @map("reviewed_by_user_id") @db.Uuid
  exceptionNotes    String?            @map("exception_notes")
  countedCash       Decimal            @default(0) @map("counted_cash") @db.Decimal(19, 4)
  report            Json
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company @relation(fields: [companyId], references: [id])
  branch    Branch  @relation(fields: [branchId], references: [id])
  preparedBy User   @relation("DailyClosingPreparedBy", fields: [preparedByUserId], references: [id])
  reviewedBy User?  @relation("DailyClosingReviewedBy", fields: [reviewedByUserId], references: [id])

  @@unique([branchId, businessDate])
  @@index([companyId, businessDate])
  @@map("daily_closings")
}

model PeriodClosingTask {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  fiscalPeriodId    String    @map("fiscal_period_id") @db.Uuid
  taskCode          String    @map("task_code")
  result            String
  note              String?
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id])
  period      FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  completedBy User?        @relation("PeriodTaskCompletedBy", fields: [completedByUserId], references: [id])

  @@unique([fiscalPeriodId, taskCode])
  @@map("period_closing_tasks")
}

